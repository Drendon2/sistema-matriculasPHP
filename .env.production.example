# =============================================================================
# PLANTILLA PARA EL SERVIDOR. No es la de desarrollo — esa es `.env.example`.
# =============================================================================
#
# Cópiala como `.env` en el servidor y rellena lo marcado con «CAMBIAR».
#
# Las cuatro líneas que de verdad importan son APP_ENV, APP_DEBUG, LOG_LEVEL y
# SESSION_SECURE_COOKIE. Con `APP_DEBUG=true` en un servidor, cualquiera que
# provoque un error 500 recibe la página de depuración de Laravel: traza
# completa, credenciales de la base y el contenido de las consultas — que aquí
# incluye nombres, teléfonos y documentos de identidad de estudiantes menores de
# edad. No es un detalle de configuración, es una filtración.
#
# APP_ENV=production hace además otra cosa: es lo único que impide que
# `php artisan simular` siembre 300 cuentas de prueba con contraseña conocida.

APP_NAME="Casa de la Cultura"
APP_ENV=production
APP_DEBUG=false

# Se genera EN EL SERVIDOR con `php artisan key:generate`. No se copia la de
# desarrollo: es la que cifra las cookies y las sesiones de la gente real.
APP_KEY=

# Con el https puesto. La aplicación fuerza el esquema en producción porque en
# hosting compartido el SSL termina antes de PHP, pero esta variable es la que
# usan los enlaces de los correos y los redirectos absolutos.
APP_URL=https://CAMBIAR.example.co

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

# De la zona horaria dependen dos reglas de negocio: si un grupo ya tiene clase
# registrada hoy, y el plazo de 48 horas para confirmarla. Ajústala antes de
# abrir matrículas si la institución no está en este huso.
APP_TIMEZONE=America/Bogota

APP_MAINTENANCE_DRIVER=file

# 12 es un equilibrio razonable en hosting compartido. Subirlo endurece las
# contraseñas y encarece cada inicio de sesión.
BCRYPT_ROUNDS=12

# `error` y no `debug`: un log en nivel debug escribe cada consulta, y en un
# plan compartido eso llena la cuota de disco y deja rastro de datos personales
# en un archivo que nadie vigila. `daily` los rota y no crece sin fin.
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=CAMBIAR
DB_USERNAME=CAMBIAR
DB_PASSWORD=CAMBIAR

# La cookie de sesión, solo por HTTPS. Sin esto Laravel la manda también por
# http plano y basta una petición a http:// para que viaje en claro.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# El proyecto no envía correo. Se deja en `log` para que, si algún día alguna
# parte intenta enviarlo, quede escrito en vez de fallar en silencio.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-responder@CAMBIAR.example.co"
MAIL_FROM_NAME="${APP_NAME}"
